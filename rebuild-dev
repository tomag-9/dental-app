#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

echo "[rebuild-dev] Rebuilding and restarting Docker dev stack..."
docker compose down --remove-orphans
docker compose up -d --build

echo "[rebuild-dev] Running Django migrations..."
docker compose exec -T backend python manage.py migrate

echo "[rebuild-dev] Service status:"
docker compose ps

echo "[rebuild-dev] Done. Frontend: http://localhost:5280  Backend: http://localhost:8810"
