# Required by Django. Dev default enables debug pages; use DEBUG=0 outside local dev.
DEBUG=1

# Required. Example-only secret for local development; set a unique value per deployed env.
SECRET_KEY=dev_secret_key

# Required. Space-separated hosts Django will serve. Default: local Docker/dev hosts.
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1] backend

# Required database settings for Django. Defaults match the postgres service below.
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=dental_db
SQL_USER=hello_django
SQL_PASSWORD=hello_django
SQL_HOST=db
SQL_PORT=5432

# Required database settings for the postgres container. Keep in sync with SQL_* above.
POSTGRES_USER=hello_django
POSTGRES_PASSWORD=hello_django
POSTGRES_DB=dental_db

# Optional local port overrides. Defaults expose backend on 8810 and frontend on 5367.
BACKEND_PORT=8810
FRONTEND_PORT=5367

# Leave empty to use the browser hostname with backend port 8810 (works on localhost and LAN).
VITE_API_URL=

# Required when cookies/CSRF are enabled. Comma-separated origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5367,http://127.0.0.1:5367,http://192.168.0.14:5367
CSRF_TRUSTED_ORIGINS=http://localhost:5367,http://127.0.0.1:5367,http://192.168.0.14:5367

# Optional logging controls. Defaults: JSON logs at INFO, request logs at INFO.
DJANGO_LOG_LEVEL=INFO
REQUEST_LOG_LEVEL=INFO

# Optional. Google OAuth client ID for "Prihlásiť sa cez Google" (#107). Leave empty
# to disable: the endpoint then answers 503 and the UI hides the button.
GOOGLE_OAUTH_CLIENT_ID=
# ---------------------------------------------------------------------------
# Stripe billing (issues #102-#104)
#
# All four may stay empty: with STRIPE_SECRET_KEY unset the billing module
# reports itself disabled, the checkout/portal/webhook endpoints answer 503,
# and nothing ever reaches the network. Dev and CI need no Stripe account.
#
# Local webhook development:
#   stripe login
#   stripe listen --forward-to http://localhost:8810/api/v1/finance/stripe/webhook/
# `stripe listen` prints a `whsec_...` secret — put it in STRIPE_WEBHOOK_SECRET.
# Trigger events with e.g. `stripe trigger customer.subscription.updated`.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Optional overrides; default to FRONTEND_BASE_URL + /settings/billing.
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=
SUBSCRIPTION_BILLING_URL=

# Days a lab keeps write access after a failed payment before the read-only
# lock engages. Run `python manage.py enforce_subscription_grace` daily.
SUBSCRIPTION_GRACE_DAYS=14
