## Root environment for development with docker compose

# Database for docker compose Postgres service
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=dental_app_dev

# Backend config
DATABASE_URL=postgresql+psycopg2://devuser:devpassword@db:5432/dental_app_dev
SECRET_KEY=dev-secret-key-change-me
ALGORITHM=HS256
APP_ENV=development

# Frontend config
VITE_PORT=5173
VITE_API_URL=http://localhost:8000
