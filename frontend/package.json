{
  "name": "dental-app-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5367",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "gen:types": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "smoke:auth": "node scripts/auth-smoke.mjs",
    "smoke:no-prod-mocks": "node scripts/no-prod-mocks-smoke.mjs",
    "smoke:permissions": "node scripts/permissions-smoke.mjs",
    "smoke:visual": "node scripts/visual-smoke.mjs",
    "smoke:role-nav": "node scripts/role-nav-smoke.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.60.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3"
  }
}
