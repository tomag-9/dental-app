## Example production environment configuration

# Registry (for docker-compose.prod.yml image references)
REGISTRY_HOST=ghcr.io/magi-9
REGISTRY_USER=dental-app

# Database (adjust to your managed Postgres or RDS)
POSTGRES_USER=produser
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=dental_app

# Backend config
DATABASE_URL=postgresql+psycopg2://produser:${POSTGRES_PASSWORD}@db:5432/dental_app
SECRET_KEY=replace-with-strong-random-secret
ALGORITHM=HS256
APP_ENV=production

# Frontend
VITE_PORT=5173
VITE_API_URL=https://your-domain.tld